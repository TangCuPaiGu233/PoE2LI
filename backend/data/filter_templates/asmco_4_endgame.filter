#=========================全域隐藏=========================
#单手武器
Hide
    Class "Claws" "Daggers" "Wands" "One Hand Swords" "One Hand Axes" "One Hand Maces" "Sceptres" "Spears" "Flails"
    Rarity <= Rare

#双手武器
#"Fishing Rods"
Hide
    Class "Bows" "Staves" "Two Hand Swords" "Two Hand Axes" "Two Hand Maces" "Quarterstaves" "Crossbows" "Traps" "Quarterstaves" "Talismans"
    Rarity <= Rare

#副手（盾牌、箭袋）
Hide
    Class "Quivers" "Shields" "Foci" "Bucklers"
    Rarity <= Rare

#胸甲、头盔、手部、鞋子
Hide
    Class "Gloves" "Boots" "Body Armours" "Helmets"
    Rarity <= Rare

#饰品（戒指、项链、腰带、护符）
Hide
    Class "Rings" "Amulets" "Belts"
    Rarity <= Rare

#药剂
Hide
    Class "Flasks" "Life Flasks" "Mana Flasks" "Charms"
    Rarity <= Magic        
#宝石
#"Meta Skill Gem" "Spirit Gems"
Hide
    Class "Gems" "Skill Gems" "Support Gems"

#=========================end===================