#显示未切割的辅助宝石L4+
Show 
    BaseType "Uncut Support Gem (Level 4)" "Uncut Support Gem (Level 5)"
    SetBorderColor 136 136 255
    SetTextColor 136 136 255
    DisableDropSound True
    CustomAlertSound "AlertSound_05.wav" 300
    MinimapIcon 2 Blue Hexagon
    PlayEffect Blue

#屏蔽特定等级未切割技能石
Hide
    BaseType "Uncut Skill Gem " "Uncut Spirit Gem " "Uncut Support Gem "

#=====================鱼竿===================
#显示 未实装
Show
    Class "Fishing Rods"
    SetBorderColor 175 96 37
    SetTextColor 255 255 255
    SetBackgroundColor 255 40 0 220
    SetFontSize 50
    DisableDropSound True
    CustomAlertSound "AlertSound_09.wav" 300
    MinimapIcon 0 Orange UpsideDownHouse
    PlayEffect Orange

