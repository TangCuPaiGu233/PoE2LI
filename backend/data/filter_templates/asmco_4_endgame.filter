    BaseType "Gemcutter's Prism" "Exalted Orb" "Lesser Jeweller's Orb" "Orb of Chance" "Orb of Annulment" "Chaos Orb"
    SetTextColor 255 0 255
    SetBorderColor 255 0 255
    CustomAlertSound "AlertSound_07.wav" 200
    SetFontSize 45
    MinimapIcon 2 Yellow Circle
    PlayEffect Yellow
    DisableDropSound

#显示 粉字通货色框 价值D[蓝光束 PlayEffect Blue]
Show
    BaseType "Vaal Orb" "Glassblower's Bauble" "Regal Orb" "Orb of Alchemy" "Armourer's Scrap" "Blacksmith's Whetstone" "Arcanist's Etcher" "Artificer's Orb"
    SetTextColor 255 0 255
    SetBorderColor 170 158 130
    SetFontSize 40
    CustomAlertSound "AlertSound_07.wav" 200
    MinimapIcon 2 Yellow Circle
    PlayEffect Blue
    DisableDropSound

#显示 粉字通货色框 价值D-[蓝光束 PlayEffect Blue]
Hide
    BaseType "Chance Shard"
    SetTextColor 255 0 255
    SetBorderColor 170 158 130
    SetFontSize 40
    #CustomAlertSound "AlertSound_07.wav" 200
    #MinimapIcon 2 Yellow Circle
    #PlayEffect Blue
    DisableDropSound

#屏蔽 通货色字 价值F
Hide
