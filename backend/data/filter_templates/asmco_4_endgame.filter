    BaseType "Orb of Augmentation" "Orb of Transmutation" "Scroll of Wisdom" "Transmutation Shard"
    DisableDropSound

# 显示 黄金 通货色字 价值F
Show
    BaseType == "Gold"
    StackSize >= 300
    SetBorderColor 170 158 130
    DisableDropSound

# 屏蔽 黄金 通货色字 价值G
Hide
    BaseType == "Gold"
    DisableDropSound

