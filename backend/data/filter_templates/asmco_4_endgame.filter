	Identified True
	Mirrored False
	Corrupted False
	Rarity <= Rare
	Class "Boots"
	HasExplicitMod >=1 "Hellion's"
	SetFontSize 40
	SetTextColor 74 230 58 255
	SetBackgroundColor 47 0 74 255
	SetBorderColor 74 230 58 255
    CustomAlertSound "AlertSound_07.wav" 200
	PlayEffect Green
	MinimapIcon 0 Green Diamond

