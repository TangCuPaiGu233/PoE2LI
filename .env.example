# PoE2LI Environment Variables

# ── MiMo LLM (active) ──
# OpenAI-compatible: https://api.xiaomimimo.com/v1
# Model: mimo-v2.5 (Pro reasoning: mimo-v2.5-pro + LLM_THINKING=enabled)
MIMO_API_KEY=your_mimo_key_here

# SiliconFlow — Embedding (BGE-M3) + LLM backup (DeepSeek)
# Register at: https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=your_siliconflow_key_here

# OpenRouter (optional LLM backup)
OPENROUTER_API_KEY=your_openrouter_key_here

# Proxy (NAS only — optional)
# HTTPS_PROXY=http://192.168.110.26:7890
# HTTP_PROXY=http://192.168.110.26:7890

# ── LLM Provider Switching ──
# Active provider is set in docker-compose.yml (backend + celery env).
# Default: MiMo MiMo-V2.5 via MIMO_API_KEY.
# To switch back to DeepSeek: comment MiMo lines, uncomment DeepSeek block in docker-compose.yml.
# Embedding always uses SiliconFlow BGE-M3 (SILICONFLOW_API_KEY) — unchanged when switching LLM.

# CN trade
# TRADE_CN_POESESSID=
